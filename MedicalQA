# Option 2: Local GPT2 mode
pipe1 = pipeline("text-generation", model="distilgpt2", max_new_tokens=200)
GenModel1 = HuggingFacePipeline(pipeline=pipe1)

from langchain_core.output_parsers import StrOutputParser
parser1 = StrOutputParser()
gen_chain1 = prompt_template1 | GenModel1 | parser1
print("Answer generation chain created.")

# Step 6: Similarity Search – Retrieve top relevant chunks.
def format_docs(docs):
    return "\n\n".join(doc.page_content for doc in docs)

from langchain_core.runnables import RunnablePassthrough

rag_chain = {
    "context": retriever1 | format_docs, 
    "question": RunnablePassthrough()
} | gen_chain1

# Step 7: Answer Generation – Produce answer from retrieved chunks.
Query1 = "What are the symptoms of alzheimer's disease?"
response1 =rag_chain.invoke(Query1)

print(f"Question: {Query1}\nAnswer: {response1}")